---
interface Props {
  label: string;
  layer: 'skills' | 'projects' | 'goals';
  x: string;
  y: string;
  side?: 'left' | 'right';
  mx?: string;
  my?: string;
  mside?: 'left' | 'right';
  href?: string;
  name?: string;
  small?: boolean;
  cross?: boolean;
  hidden?: boolean;
}

const { label, layer, x, y, side = 'right', mx, my, mside, href, name, small = false, cross = false, hidden = false } = Astro.props;
const style = [`--x: ${x}`, `--y: ${y}`, mx && `--mx: ${mx}`, my && `--my: ${my}`].filter(Boolean).join('; ');
const Tag = href ? 'a' : 'span';
---

<Tag
  class:list={['pin', `pin-${layer}`, `pin-${side}`, mside && `pin-m-${mside}`, small && 'pin-small']}
  href={href}
  aria-label={name}
  data-layer={layer}
  style={style}
  hidden={hidden}
>
  {cross && <span class="pin-cross" aria-hidden="true" />}
  <span class="pin-ring" aria-hidden="true"><span class="pin-dot" /></span>
  <span class="pin-label">{label}</span>
</Tag>
