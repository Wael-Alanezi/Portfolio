---
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ProjectFigure from './ProjectFigure.astro';
import Arrow from './Arrow.astro';
import { getSite, home, projectHref, type Lang, type Project } from '../lib/site';
import '../styles/case.css';

interface Props {
  project: Project;
  next: Project;
  lang: Lang;
}

const { project, next, lang } = Astro.props;
const t = await getSite(lang);
const { Content } = await render(project.entry);
const other = lang === 'ar' ? 'en' : 'ar';
---

<Layout
  title={`${project.title} | ${t.name}`}
  description={project.description}
  lang={lang}
  alternates={{ en: projectHref(project.id, 'en'), ar: projectHref(project.id, 'ar') }}
  skip={t.skipToContent}
  ogAlt={t.ogAlt}
>
  <Header lang={lang} alternate={projectHref(project.id, other)} />

  <main id="main" class="case">
    <header class="case-head blueprint">
      <div class="container case-head-inner">
        <a class="back-link" href={`${home(lang)}#work`}>
          <Arrow />
          {t.caseStudy.back}
        </a>
        <p class="label">{project.meta.join(' · ')}</p>
        <h1>{project.title}</h1>
        {project.status && <p class="chip chip-status">{project.status}</p>}
        <p class="lead">{project.description}</p>
        {project.context && <p class="case-context">{project.context}</p>}
        <ul class="chips">
          {project.tags.map((tag) => <li class="chip">{tag}</li>)}
        </ul>
      </div>
    </header>

    <div class="container case-layout">
      <div class="case-figure">
        <ProjectFigure project={project} lang={lang} large />
      </div>

      <div class="prose">
        <Content />
      </div>

      <aside class="case-side">
        {
          project.stack.length > 0 && (
            <div>
              <h2 class="label">{t.caseStudy.stack}</h2>
              <ul class="chips" translate="no">
                {project.stack.map((item) => <li class="chip" lang="en">{item}</li>)}
              </ul>
            </div>
          )
        }
        {
          project.links.length > 0 && (
            <div>
              <h2 class="label">{t.caseStudy.links}</h2>
              <ul class="case-links">
                {project.links.map((link) => (
                  <li>
                    <a class="text-link" href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>

    {
      next.id !== project.id && (
        <div class="container">
          <a class="next" href={next.href}>
            <span class="label">{t.caseStudy.next}</span>
            <span class="next-title">
              {next.title}
              <Arrow />
            </span>
          </a>
        </div>
      )
    }
  </main>

  <Footer lang={lang} />
</Layout>
