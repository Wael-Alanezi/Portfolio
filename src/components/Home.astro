---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import SectionHead from './SectionHead.astro';
import WorkRow from './WorkRow.astro';
import ProjectFigure from './ProjectFigure.astro';
import Certificates from './Certificates.astro';
import Icon from './Icon.astro';
import Arrow from './Arrow.astro';
import { getSite, getProjects, type Lang } from '../lib/site';
import '../styles/home.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = await getSite(lang);
const other = lang === 'ar' ? 'en' : 'ar';
const projects = await getProjects(lang);
const work = projects.filter((project) => project.group === 'work');
const more = projects.filter((project) => project.group === 'more');
---

<Layout
  title={t.title}
  description={t.description}
  lang={lang}
  alternates={{ en: '/', ar: '/ar/' }}
  skip={t.skipToContent}
  ogAlt={t.ogAlt}
>
  <Header lang={lang} alternate={lang === 'ar' ? '/' : '/ar/'} onHome />

  <main id="main">
    <section class="hero blueprint" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-text">
          <p class="label">{t.hero.kicker}</p>
          <h1 id="hero-title">
            {t.name}
            <span class="other-name" lang={other} dir={other === 'ar' ? 'rtl' : 'ltr'}>{t.otherName}</span>
          </h1>
          <p class="role">{t.hero.role}</p>
          <p class="lead">{t.hero.lead}</p>
          <div class="actions">
            <a class="btn btn-primary" href="#work">{t.hero.work}</a>
            <a class="btn btn-secondary" href={t.cv}>{t.hero.cv}</a>
          </div>
        </div>
        <ul class="proof" aria-label={t.hero.proofLabel}>
          {
            t.hero.proof.map((item) => (
              <li>
                <a class:list={['proof-item', { 'is-accent': item.accent }]} href={item.href}>
                  <span class="label">{item.label}</span>
                  <span class="proof-value num">{item.value}</span>
                  <span class="proof-note">{item.note}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section section-alt" id="work" aria-labelledby="work-title">
      <div class="container">
        <SectionHead id="work-title" index={t.work.index} title={t.work.title} />
        <div class="work-list">
          {
            work.map((project) => (
              <WorkRow project={project} readCase={t.work.readCase}>
                <ProjectFigure project={project} />
              </WorkRow>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="programs" aria-labelledby="programs-title">
      <div class="container">
        <SectionHead id="programs-title" index={t.programs.index} title={t.programs.title} />
        <ol class="timeline">
          {
            t.programs.items.map((item) => (
              <li class="timeline-row">
                <p class="timeline-date num">{item.date}</p>
                <h3 class="timeline-title">{item.title}</h3>
                <div class="timeline-text">
                  <p>{item.text}</p>
                  {item.links.length > 0 && (
                    <ul class="inline-links">
                      {item.links.map((link) => (
                        <li>
                          <a class="text-link" href={link.href}>
                            {link.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section section-alt" id="more" aria-labelledby="more-title">
      <div class="container">
        <SectionHead id="more-title" index={t.more.index} title={t.more.title} />
        <div class="cards">
          {
            more.map((project) => (
              <article class="card" aria-labelledby={`${project.id}-title`}>
                <ProjectFigure project={project} />
                <div class="card-text">
                  <p class="label">{project.meta.join(' · ')}</p>
                  <h3 id={`${project.id}-title`}>{project.title}</h3>
                  {project.status && <p class="chip chip-status">{project.status}</p>}
                  <p>{project.summary}</p>
                  <a class="row-link" href={project.href}>
                    {t.work.readCase}
                    <span class="visually-hidden">: {project.title}</span>
                    <Arrow />
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="training" aria-labelledby="training-title">
      <div class="container">
        <SectionHead id="training-title" index={t.training.index} title={t.training.title}>
          <p class="section-intro">{t.training.subtitle}</p>
        </SectionHead>
        <div class="training-grid">
          <Certificates items={t.training.items} close={t.training.close} missing={t.training.missing} />
          <div class="coursework">
            <h3 class="label">{t.training.coursesLabel}</h3>
            <p>{t.training.courses}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="about" aria-labelledby="about-title">
      <div class="container about-grid">
        <div class="about">
          <SectionHead id="about-title" index={t.about.index} title={t.about.title} />
          <p class="lead">{t.about.text}</p>
          <dl class="facts">
            {
              t.about.facts.map((fact) => (
                <div>
                  <dt class="label">{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="contact" id="contact">
          <h2 id="contact-title">{t.contact.title}</h2>
          <ul class="contact-list" aria-labelledby="contact-title">
            <li>
              <a href={`mailto:${t.email}`}>
                <Icon name="mail" />
                <span class="label">{t.contact.email}</span>
                <span class="contact-value" dir="ltr">{t.email}</span>
              </a>
            </li>
            <li>
              <a href={`tel:${t.phone}`}>
                <Icon name="phone" />
                <span class="label">{t.contact.phone}</span>
                <span class="contact-value num" dir="ltr">{t.phoneDisplay}</span>
              </a>
            </li>
            <li>
              <a href={t.linkedin}>
                <Icon name="linkedin" />
                <span class="label">{t.contact.linkedin}</span>
                <span class="contact-value" dir="ltr">linkedin.com/in/wael-alanezi</span>
              </a>
            </li>
            <li>
              <a href={t.github}>
                <Icon name="github" />
                <span class="label">{t.contact.github}</span>
                <span class="contact-value" dir="ltr">github.com/Wael-Alanezi</span>
              </a>
            </li>
          </ul>
          <a class="btn btn-primary contact-cv" href={t.cv}>
            <Icon name="download" />
            {t.contact.cv}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>
