---
interface Props {
  steps: string[];
  label: string;
  planned?: string;
}

const { steps, label, planned } = Astro.props;
---

<div class="flow-wrap">
  {planned && <p class="flow-planned label">{planned}</p>}
  <ol class:list={['flow', { 'is-planned': planned }]} aria-label={label}>
    {
      steps.map((step, i) => (
        <li>
          {i > 0 && <span class="connector" aria-hidden="true" />}
          <span class="flow-num num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="flow-name">{step}</span>
        </li>
      ))
    }
  </ol>
</div>
