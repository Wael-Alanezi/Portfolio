---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/figtree/wght.css';
import '../../styles/base.css';
import '../../styles/spread.css';
import Head from '../../components/Head.astro';
import Certificates from '../../components/Certificates.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import { getSite, getProjects } from '../../lib/site';

const site = await getSite();
const projects = await getProjects();
const featured = projects.filter((project) => project.data.size === 'featured');
const smaller = projects.filter((project) => project.data.size === 'small');
---

<html lang="en" dir="ltr">
  <head>
    <Head title={site.title} description={site.description} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="top wrap">
      <a class="wordmark" href="#main">{site.name}</a>
      <nav aria-label="Primary">
        <a href="#work">Work</a>
        <a href="#experience">Experience</a>
        <a href="#training">Training</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero wrap grid">
        <h1>{site.headline}</h1>
        <dl class="facts">
          <div>
            <dt>Studying</dt>
            <dd>Software Engineering, Prince Sultan University</dd>
          </div>
          <div>
            <dt>Working</dt>
            <dd>Land operations supervisor</dd>
          </div>
          <div>
            <dt>Based in</dt>
            <dd>Riyadh</dd>
          </div>
        </dl>
        <div class="hero-text">
          <p class="intro">{site.intro}</p>
          <p class="proof">{site.proof}</p>
          <div class="actions">
            <a class="button" href="#work">View projects</a>
            <a class="quiet" href={site.cv}>Download CV</a>
            <a class="quiet" href={`mailto:${site.email}`}>Email me</a>
          </div>
        </div>
      </section>

      <section id="work" class="band" aria-labelledby="work-title">
        <div class="wrap">
          <h2 id="work-title" class="title">Selected work</h2>
          <div class="index" data-index>
            {
              featured.map((project, i) => (
                <>
                  <a
                    class="index-item"
                    href={`/projects/${project.id}`}
                    data-key={project.id}
                    data-active={i === 0 ? 'true' : undefined}
                    style={`--row: ${i + 1}`}
                  >
                    <span class="index-title">{project.data.title}</span>
                    <span class="index-line">{project.data.oneLine}</span>
                  </a>
                  <div class="index-detail" data-key={project.id} data-active={i === 0 ? 'true' : undefined}>
                    {project.data.result && <p class="index-result">{project.data.result}</p>}
                    <p class="index-context">{project.data.context}</p>
                    <p class="index-stack">{project.data.stack.join(', ')}</p>
                    <ProjectLinks links={[{ label: 'Read the case study', href: `/projects/${project.id}` }, ...project.data.links]} />
                  </div>
                </>
              ))
            }
          </div>

          <div class="extra grid">
            {
              smaller.map((project) => (
                <div class="extra-project">
                  <h3>
                    <a href={`/projects/${project.id}`}>{project.data.title}</a>
                  </h3>
                  <p>{project.data.oneLine}</p>
                  <p class="muted">{project.data.stack.join(', ')}</p>
                  <ProjectLinks links={project.data.links} />
                </div>
              ))
            }
            <div class="extra-more">
              <h3>More on GitHub</h3>
              <ul>
                {
                  site.more.map((item) => (
                    <li>
                      <strong>{item.name}</strong> {item.text}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="row wrap grid" aria-labelledby="about-title">
        <h2 id="about-title" class="title">About</h2>
        <p class="body large">{site.about}</p>
      </section>

      <section id="experience" class="row wrap grid" aria-labelledby="experience-title">
        <h2 id="experience-title" class="title">Experience</h2>
        <div class="body">
          {
            site.experience.map((job) => (
              <div class="entry">
                <h3>{job.role}</h3>
                <p class="muted">
                  {job.company}, {job.place}. {job.period}
                </p>
                <ul class="points">
                  {job.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section class="row wrap grid" aria-labelledby="education-title">
        <h2 id="education-title" class="title">Education</h2>
        <div class="body entry">
          <h3>{site.education.degree}</h3>
          <p class="muted">
            {site.education.school}, {site.education.place}. {site.education.detail}
          </p>
          <p class="courses">Relevant courses: {site.education.courses}</p>
        </div>
      </section>

      <section id="training" class="row wrap grid" aria-labelledby="training-title">
        <h2 id="training-title" class="title">Training and certifications</h2>
        <div class="body">
          <Certificates items={site.training} />
        </div>
      </section>

      <section class="row wrap grid" aria-labelledby="activities-title">
        <h2 id="activities-title" class="title">Activities</h2>
        <ul class="body points">
          {site.activities.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section id="contact" class="contact wrap" aria-labelledby="contact-title">
        <h2 id="contact-title" class="visually-hidden">Contact</h2>
        <p class="contact-line">{site.contact}</p>
        <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
        <ul class="contact-links">
          <li><a href={site.linkedin}>LinkedIn</a></li>
          <li><a href={site.github}>GitHub</a></li>
          <li><a href={site.cv}>Download CV</a></li>
        </ul>
      </section>
    </main>

    <footer class="footer wrap">
      <p>Built with Claude Code. <a href="https://github.com/wael-alanezi/portfolio">Source on GitHub</a>.</p>
      <p>{site.name}, Riyadh</p>
    </footer>

    <script>
      const index = document.querySelector<HTMLElement>('[data-index]');
      const wide = window.matchMedia('(min-width: 960px)');

      if (index) {
        const parts = [...index.querySelectorAll<HTMLElement>('[data-key]')];

        const activate = (key: string) => {
          parts.forEach((part) => {
            if (part.dataset.key === key) part.dataset.active = 'true';
            else delete part.dataset.active;
          });
        };

        const pick = (event: Event) => {
          if (!wide.matches) return;
          const part = (event.target as Element).closest<HTMLElement>('[data-key]');
          if (part?.dataset.key) activate(part.dataset.key);
        };

        index.addEventListener('pointerover', pick);
        index.addEventListener('focusin', pick);
      }
    </script>
  </body>
</html>
