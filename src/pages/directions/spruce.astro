---
import '@fontsource-variable/geist/wght.css';
import '../../styles/base.css';
import '../../styles/spruce.css';
import Head from '../../components/Head.astro';
import Certificates from '../../components/Certificates.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import { getSite, getProjects } from '../../lib/site';

const site = await getSite();
const projects = await getProjects();
const featured = projects.filter((project) => project.data.size === 'featured');
const smaller = projects.filter((project) => project.data.size === 'small');

const sections = [
  { id: 'work', label: 'Work' },
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'training', label: 'Training' },
  { id: 'contact', label: 'Contact' },
];
---

<html lang="en" dir="ltr">
  <head>
    <Head title={site.title} description={site.description} themeScript />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <aside class="side">
        <div>
          <p class="name">{site.name}</p>
          <p class="role">Software Engineering student, Riyadh</p>
          <h1>{site.headline}</h1>
          <p class="intro">{site.intro}</p>
          <p class="proof">{site.proof}</p>
          <div class="actions">
            <a class="button primary" href="#work">View projects</a>
            <a class="button" href={site.cv}>Download CV</a>
            <a class="button" href={`mailto:${site.email}`}>Email me</a>
          </div>
          <nav class="toc" aria-label="Sections">
            <span class="toc-marker" aria-hidden="true"></span>
            {
              sections.map((section) => (
                <a href={`#${section.id}`} data-section={section.id}>
                  {section.label}
                </a>
              ))
            }
          </nav>
        </div>
        <div class="side-foot">
          <a href={site.github}>GitHub</a>
          <a href={site.linkedin}>LinkedIn</a>
          <button type="button" class="theme" data-theme-toggle>Light theme</button>
        </div>
      </aside>

      <main id="main" class="main">
        <section id="work" class="section" aria-labelledby="work-title">
          <h2 id="work-title">Selected work</h2>
          <ul class="work">
            {
              featured.map((project) => (
                <li class="project">
                  <div class="project-head">
                    <h3>
                      <a href={`/projects/${project.id}`}>{project.data.title}</a>
                    </h3>
                    <ProjectLinks links={project.data.links} />
                  </div>
                  <p>{project.data.oneLine}</p>
                  {project.data.result && <p class="result">{project.data.result}</p>}
                  <ul class="stack">
                    {project.data.stack.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </li>
              ))
            }
            {
              smaller.map((project) => (
                <li class="project compact">
                  <div class="project-head">
                    <h3>
                      <a href={`/projects/${project.id}`}>{project.data.title}</a>
                    </h3>
                    <ProjectLinks links={project.data.links} />
                  </div>
                  <p>{project.data.oneLine}</p>
                </li>
              ))
            }
          </ul>
          <div class="more">
            <h3>More on GitHub</h3>
            <dl>
              {
                site.more.map((item) => (
                  <div>
                    <dt>{item.name}</dt>
                    <dd>{item.text}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </section>

        <section id="about" class="section" aria-labelledby="about-title">
          <h2 id="about-title">About</h2>
          <p class="lead">{site.about}</p>
        </section>

        <section id="experience" class="section" aria-labelledby="experience-title">
          <h2 id="experience-title">Experience and education</h2>
          <ol class="timeline">
            {
              site.experience.map((job) => (
                <li>
                  <p class="when">{job.period}</p>
                  <div>
                    <h3>{job.role}</h3>
                    <p class="where">
                      {job.company}, {job.place}
                    </p>
                    <ul class="points">
                      {job.points.map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  </div>
                </li>
              ))
            }
            <li>
              <p class="when">Expected 2028</p>
              <div>
                <h3>{site.education.degree}</h3>
                <p class="where">
                  {site.education.school}, {site.education.place}. {site.education.detail}
                </p>
                <p class="points-text">Relevant courses: {site.education.courses}</p>
              </div>
            </li>
          </ol>
        </section>

        <section id="training" class="section" aria-labelledby="training-title">
          <h2 id="training-title">Training and certifications</h2>
          <Certificates items={site.training} />
          <h3 class="sub">Activities</h3>
          <ul class="points">
            {site.activities.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section id="contact" class="section" aria-labelledby="contact-title">
          <h2 id="contact-title">Contact</h2>
          <p class="lead">{site.contact}</p>
          <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
          <ul class="contact-links">
            <li><a href={site.linkedin}>LinkedIn</a></li>
            <li><a href={site.github}>GitHub</a></li>
            <li><a href={site.cv}>Download CV</a></li>
          </ul>
        </section>

        <footer class="footer">
          Built with Claude Code. <a href="https://github.com/wael-alanezi/portfolio">Source on GitHub</a>.
        </footer>
      </main>
    </div>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const root = document.documentElement;
      const label = () => {
        if (toggle) toggle.textContent = root.dataset.theme === 'light' ? 'Dark theme' : 'Light theme';
      };
      label();
      toggle?.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
        try {
          localStorage.setItem('theme', root.dataset.theme);
        } catch {}
        label();
      });

      const toc = document.querySelector<HTMLElement>('.toc');
      const marker = document.querySelector<HTMLElement>('.toc-marker');
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];

      const mark = (id: string) => {
        const link = links.find((item) => item.dataset.section === id);
        if (!link || !marker || !toc) return;
        links.forEach((item) => item.removeAttribute('aria-current'));
        link.setAttribute('aria-current', 'true');
        marker.style.transform = `translateY(${link.offsetTop}px)`;
        marker.style.blockSize = `${link.offsetHeight}px`;
        marker.style.inlineSize = `${link.offsetWidth}px`;
        toc.classList.add('is-ready');
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => entry.isIntersecting && mark(entry.target.id));
        },
        { rootMargin: '-35% 0px -60% 0px' },
      );

      links.forEach((link) => {
        const target = document.getElementById(link.dataset.section ?? '');
        if (target) observer.observe(target);
      });
      mark('work');
    </script>
  </body>
</html>
