---
import Layout from '../layouts/Layout.astro';
import MapGrid from '../components/MapGrid.astro';
import { getSite } from '../lib/site';

const en = await getSite('en');
const ar = await getSite('ar');
---

<Layout title={`${en.notFound.title} | ${en.name}`} description={en.notFound.text} skip={en.skipToContent}>
  <main id="main" class="missing">
    <div class="missing-map" aria-hidden="true">
      <MapGrid cols={40} rows={22} cell={48} gap={2} />
    </div>
    <div class="missing-text">
      <p class="coords">404 · 24.7346° N, 46.6982° E</p>
      <h1>{en.notFound.title}</h1>
      <p>{en.notFound.text}</p>
      <a class="btn btn-primary" href="/">{en.notFound.home}</a>
      <div class="missing-ar" lang="ar" dir="rtl">
        <h2>{ar.notFound.title}</h2>
        <p>{ar.notFound.text}</p>
        <a class="btn btn-secondary" href="/ar/" hreflang="ar">{ar.notFound.home}</a>
      </div>
    </div>
  </main>
</Layout>
