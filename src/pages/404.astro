---
import Layout from '../layouts/Layout.astro';
import { getSite } from '../lib/site';

const site = await getSite();
---

<Layout title={`Page not found | ${site.name}`} description="This page does not exist.">
  <div class="case">
    <header class="case-top">
      <a class="name" href="/">{site.name}</a>
    </header>
    <main id="main" class="missing">
      <h1>Page not found</h1>
      <p>This page doesn't exist or has moved. The projects, experience and contact details are on the home page.</p>
      <a class="button primary" href="/">Go to the home page</a>
    </main>
  </div>
</Layout>
