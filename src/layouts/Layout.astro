---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site.css';
import '../styles/diagrams.css';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ar';
  alternates: { en: string; ar: string };
  skip: string;
  ogAlt: string;
}

const { title, description, lang = 'en', alternates, skip, ogAlt } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const dir = lang === 'ar' ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site)} />
    <link rel="alternate" hreflang="ar" href={new URL(alternates.ar, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site)} />
    <Font cssVariable="--font-sans" preload={lang === 'en'} />
    <Font cssVariable="--font-arabic" preload={lang === 'ar'} />
    <Font cssVariable="--font-mono" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0B1622" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={lang === 'ar' ? 'وائل العنزي' : 'Wael Alanezi'} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_SA'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      lang === 'en' && Astro.url.pathname === '/' && (
        <script is:inline>
          try {
            if (localStorage.getItem('lang') === 'ar') location.replace('/ar/');
          } catch {}
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{skip}</a>
    <slot />
    <script>
      document.querySelectorAll<HTMLAnchorElement>('[data-set-lang]').forEach((link) =>
        link.addEventListener('click', () => {
          try {
            localStorage.setItem('lang', link.dataset.setLang ?? 'en');
          } catch {}
        }),
      );
    </script>
  </body>
</html>
